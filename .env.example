# Copy to .env.local for local dev. Never commit real values.

# Database: Neon Postgres connection string (required on Vercel).
# Leave empty locally to use PGlite (in-process Postgres, data in memory or PGLITE_DATA_DIR).
DATABASE_URL=
# PGLITE_DATA_DIR=./.data/pglite

# Required in production: long random string (>= 16 chars), e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Fixed public URL (the Google OAuth redirect URI is APP_URL/api/auth/google/callback)
APP_URL=

# Google Sign-In (OAuth 2.0 client). Unset = the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google services
GEMINI_API_KEY=
GEMINI_MODEL=            # optional, default gemini-3.5-flash

# Gmail SMTP (App Password; needs 2-Step Verification). Needed in production for sign-up codes.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Adaption (Care Communication Engine) — optional; template fallback without it
ADAPTION_API_KEY=
ADAPTION_MODEL=          # optional, default gemma-4-31b-it
ADAPTION_STACK_ID=       # optional, uses model "stack:<id>"
